# Application Settings
APP_NAME=LifeVault
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://lifevault:your_password_here@localhost:5432/lifevault_db

# Security & Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=8

# Face Recognition
FACE_DETECTION_METHOD=hog
FACE_RECOGNITION_TOLERANCE=0.6
MAX_FACES_PER_USER=5
FACE_ENCODING_MODEL=large

# File Storage
UPLOAD_DIR=./data/uploads
FACE_DATA_DIR=./data/face_data
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Camera Settings (RPi5)
CAMERA_RESOLUTION_WIDTH=2592
CAMERA_RESOLUTION_HEIGHT=1944
CAMERA_FRAMERATE=15

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/lifevault.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
